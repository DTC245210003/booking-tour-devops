<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookingTour</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark nav-glass sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Tours" asp-action="Index">✈️ BookingTour</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Tours" asp-action="Index">🗺️ Tour</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Tours" asp-action="Bookings">📊 Quản lý đặt tour</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <main class="container py-4">
        @RenderBody()
    </main>
    <footer class="site">
        © 2026 BookingTour · Đề 20 – Triển khai và Quản trị Hệ thống Phần mềm · Chạy trên Docker Compose 🐳
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
